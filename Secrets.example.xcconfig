// Secrets.example.xcconfig
//
// TEMPLATE — safe to commit. Do NOT put your real key here.
//
// Setup (one time, on your Mac):
//   1. Copy this file to "Secrets.xcconfig" in the same folder:
//        cp Secrets.example.xcconfig Secrets.xcconfig
//   2. Open Secrets.xcconfig and paste your TMDB v3 API key after the "=".
//   3. Build & run. Secrets.xcconfig is git-ignored, so your key never gets
//      committed.
//
// Notes:
//   - Use the TMDB "API Key (v3 auth)" — the ~32-character key, NOT the long
//     v4 Bearer token.
//   - The Anthropic key comes from the Anthropic Console → API Keys.
//   - No quotes, no spaces issues — just paste the key right after the "=".

TMDB_API_KEY =
ANTHROPIC_API_KEY =
